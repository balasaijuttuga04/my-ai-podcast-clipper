{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "apt": ["ffmpeg", "python3", "python3-pip"]
  },
  "steps": {
    "install": {
      "commands": [
        "npm ci",
        "pip3 install --break-system-packages yt-dlp"
      ]
    },
    "build": {
      "commands": ["npm run build"]
    }
  },
  "deploy": {
    "startCommand": "npm run start"
  }
}
