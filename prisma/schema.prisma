generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model VideoJob {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  clipCount Int
  status    String   @default("completed")
  createdAt DateTime @default(now())
}