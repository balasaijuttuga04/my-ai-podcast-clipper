generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model VideoJob {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  clipCount Int
  status    String   @default("completed")
  createdAt DateTime @default(now())

  clips Clip[]
}

model Clip {
  id            String   @id @default(cuid())
  userId        String
  jobId         String
  title         String
  fileName      String
  filePath      String
  thumbnailPath String?
  start         Float
  end           Float
  createdAt     DateTime @default(now())

  job VideoJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
